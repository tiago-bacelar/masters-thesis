{
  "latex-workshop.latex.outDir": "./build",
  "latex-workshop.latex.clean.fileTypes": [
      "*.aux",
      "*.bbl",
      "*.blg",
      "*.idx",
      "*.ind",
      "*.lof",
      "*.lot",
      "*.out",
      "*.toc",
      "*.acn",
      "*.acr",
      "*.alg",
      "*.glg",
      "*.glo",
      "*.gls",
      "*.ist",
      "*.fls",
      "*.log",
      "*.fdb_latexmk",
      "*.synctex.gz",
      "*.nav",
      "*.snm",
      "*.vrb"
  ],
  "latex-workshop.latex.tools": [
      {
          "name": "lualatex",
          "command": "lualatex",
          "args": [
              "-synctex=1",
              "-interaction=nonstopmode",
              "-file-line-error",
              "-output-directory=build",
              "-shell-escape",
              "%DOC%"
          ]
      },
      {
        "name": "xetex",
        "command": "xetex",
        "args": [
            "-synctex=1",
            "-interaction=nonstopmode",
            "-file-line-error",
            "-output-directory=build",
            "-shell-escape",
            "%DOC%"
        ]
      },
      {
          "name": "pdflatex",
          "command": "pdflatex",
          "args": [
              "-synctex=1",
              "-interaction=nonstopmode",
              "-file-line-error",
              "-output-directory=build",
              "%DOC%"
          ]
      },
      {
          "name": "bibtex",
          "command": "bibtex",
          "args": [
              "build/%DOCFILE%"
          ]
      },
      {
          "name": "makeindex",
          "command": "makeindex",
          "args": [
              "build/%DOCFILE%.idx"
          ]
      }
  ],
  "latex-workshop.latex.recipes": [
      {
          "name": "lualatex ➞ bibtex ➞ lualatex×2",
          "tools": [
              "lualatex",
              "bibtex",
              "lualatex",
              "lualatex"
          ]
      },
      {
        "name": "xetex ➞ bibtex ➞ xetex×2",
        "tools": [
            "xetex",
            "bibtex",
            "xetex",
            "xetex"
        ]
      },
      {
          "name": "pdflatex ➞ bibtex ➞ pdflatex×2",
          "tools": [
              "pdflatex",
              "bibtex",
              "pdflatex",
              "pdflatex"
          ]
      },
      {
          "name": "lualatex ➞ bibtex ➞ makeindex ➞ lualatex×2",
          "tools": [
              "lualatex",
              "bibtex",
              "makeindex",
              "lualatex",
              "lualatex"
          ]
      }
  ],
  "latex-workshop.latex.recipe.default": "lualatex ➞ bibtex ➞ lualatex×2",
  "latex-workshop.view.pdf.viewer": "tab",
  "latex-workshop.synctex.afterBuild.enabled": true,
  "latex-workshop.latex.clean.subfolder.enabled": true,
  "latex-workshop.latex.autoClean.run": "onBuilt",
  "editor.wordWrap": "on",
  "editor.minimap.autohide": "mouseover",
  "breadcrumbs.enabled": false
}
